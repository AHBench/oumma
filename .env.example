# Oumma — environment override file (copy to .env and adjust).
#
#   cp .env.example .env
#   docker compose -f docker-compose.yaml -f docker-compose.local.yml up -d --build
#
# Every variable is optional — the compose files carry working defaults.
# This file is the single place to switch the whole stack to production
# endpoints without touching the compose files.

# =============== LLM (OpenAI-compatible endpoint) ===============
# Base URL of the chat-completions endpoint (must end with /v1).
#   vLLM example:      http://<your-vllm-host>:8081/v1
#   Ollama example:    http://<your-ollama-host>:11434/v1
#   OpenAI:            https://api.openai.com/v1
OPENAI_BASE_URL=http://llm.local/v1
# Model name served by that endpoint.
OPENAI_MODEL=your-model-name
# API key — empty for keyless local servers; required for remote servers
# that enforce auth (vLLM --api-key, OpenAI, …).
OPENAI_API_KEY=
# Optional tuning (defaults shown) — shared by both modes.
LLM_KEEP_ALIVE=5m
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.7
# Seconds before a single LLM call is aborted.
LLM_CALL_TIMEOUT_SEC=300

# =============== Designer-mode LLM (optional) ===============
# The design chat (Process Design → chat) can run on a DIFFERENT LLM than
# the process-mode agent (AI Assist, routing, document analysis).
# Leave all three empty → the design chat uses the process LLM above.
DESIGNER_OPENAI_BASE_URL=
DESIGNER_OPENAI_MODEL=
DESIGNER_OPENAI_API_KEY=

# =============== MCP-like tools (system tasks) ===============
# "true"  (default): dry-run — build the exact payload, log it, simulate success.
# "false": real delivery — the per-task credentials configured in the
#          designer's Tools tab must be real.
MCP_TOOLS_DRY_RUN=true
# Telegram Bot API base (self-hosted bots-api proxy, etc.).
MCP_TELEGRAM_API_BASE=https://api.telegram.org
# Fallback email gateway for Gmail tasks (a task's own gateway field wins).
# Any JSON mail API accepting POST {from,to,subject,body}.
MCP_GMAIL_GATEWAY=
# Meta WhatsApp Cloud API base.
MCP_WHATSAPP_API_BASE=https://graph.facebook.com/v18.0
# Seconds before an outbound tool call is aborted.
MCP_HTTP_TIMEOUT_SEC=30

# =============== Auth / Keycloak ===============
# NOTE: the defaults below (realm brief-test-realm, clients briefuserapp /
# oumma-admin) are the LOCAL test realm shipped with the stack — they are
# there so the demo works out of the box. For anything beyond local
# development, create your own realm + clients and set these variables.
KEYCLOAK_URL=http://host.docker.internal:8080
KEYCLOAK_REALM=brief-test-realm
KEYCLOAK_CLIENT_ID=briefuserapp
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=oumma-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# =============== Email delivery (activation links, quota claims) ===============
# Priority: Keycloak realm SMTP settings → these SMTP_* vars →
# HTTP gateway → container log.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=oumma@brief-dz.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
# HTTP mail gateway fallback (JSON API), and its From address.
ACTIVATION_EMAIL_GATEWAY=
ACTIVATION_EMAIL_FROM=

# =============== Ports ===============
# The platform is exposed on ONE external port (8095) with path-based links:
#   :8095/api/auth/...      auth, registration, activation
#   :8095/api/management/... designer & management APIs
#   :8095/api/user-processes  process read model
#   :8095/agent/...         AI agent (process mode)
#   :8095/processes/...     engine (start/complete/tasks/documents/audit)
#   :8095/dms-api/...       document service
#   :8095/oper-api/...      operational form index
#   :8095/mailpit/          Mailpit web inbox (activation emails)
# No other host ports are published (Postgres is reached via
# `docker exec -it oumma-postgres-1 psql -U oumma -d oumma`).
# The /mailpit/ inbox target inside the compose network:
MAILPIT_WEB_URL=http://mailpit:8025
# OUMMA_PORT=8095

# =============== Token quota (monthly LLM budget per user) ===============
# 0 = unlimited.
NORMAL_USER_TOKEN_QUOTA=20000
DESIGNER_TOKEN_QUOTA=50000
# Recipient of "claim quota" top-up requests.
QUOTA_CLAIM_EMAIL=contact@brief-dz.com
